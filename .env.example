# Create a bot via https://t.me/BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=

# Optional, recommended for higher OpenSky quotas. Use API client credentials,
# not your OpenSky account username/password. Leave both empty for anonymous access.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
SEARCH_RADIUS_KM=50
# Each active chat consumes a provider request per interval (two at the date line).
POLL_INTERVAL_SECONDS=60
# Optional local override. Docker defaults to /data/airways.sqlite3.
# STATE_DB_PATH=data/airways.sqlite3

# Optional admin page. Disabled when ADMIN_PASSWORD is empty.
ADMIN_PASSWORD=
# Local default; Docker binds to 0.0.0.0 automatically.
# ADMIN_HOST=127.0.0.1
ADMIN_PORT=8080
# Keep 1 when serving behind HTTPS (e.g. Coolify). Use 0 for local HTTP only.
ADMIN_SECURE_COOKIE=1
