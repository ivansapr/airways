# Create a bot via https://t.me/BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=

# Owner account: used only by chats that redeem a promo code.
# Use API client credentials, not your OpenSky account username/password.
# Leave both empty to disable owner-funded access; own-credential chats still work.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Required to accept and encrypt user-provided credentials. Generate once:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Keep this key stable and back it up separately from the database.
CREDENTIAL_ENCRYPTION_KEY=
SEARCH_RADIUS_KM=50
# Each active chat consumes a provider request per interval (two at the date line).
POLL_INTERVAL_SECONDS=60
# Optional local override. Docker defaults to /data/airways.sqlite3.
# STATE_DB_PATH=data/airways.sqlite3
# Optional Compose volume name. Keep it unchanged across redeployments.
# AIRWAYS_DATA_VOLUME=airways-data

# Optional admin page. Disabled when ADMIN_PASSWORD is empty.
ADMIN_PASSWORD=
# Local default; Docker binds to 0.0.0.0 automatically.
# ADMIN_HOST=127.0.0.1
ADMIN_PORT=8080
# Keep 1 when serving behind HTTPS (e.g. Coolify). Use 0 for local HTTP only.
ADMIN_SECURE_COOKIE=1
